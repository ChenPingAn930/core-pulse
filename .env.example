# ============================================
# CorePulse 环境变量配置模板
# 使用方法：复制本文件为 .env，然后填写下面的值
#   Windows:  copy .env.example .env
#   Linux:    cp .env.example .env
# ============================================

# MySQL root 密码（Docker 容器内 MySQL 使用，可自定义）
MYSQL_PASSWORD=123456

# ===== LLM API Key（必填，否则 AI 功能不可用）=====
# 微信（腾讯混元）API Key
WECHAT_API_KEY=

# DeepSeek API Key
DEEPSEEK_API_KEY=

# 阿里百炼（DashScope）Embedding API Key
DASHSCOPE_API_KEY=